# Dependencies
node_modules/

# Packaged extension builds (zip / unpacked release trees under repo root)
/dist/
/dist/**

# Local agent-browser profile, screenshots, session junk
.browser/
screenshots/

# OS / editor
.DS_Store
**/.DS_Store
.idea/
.vscode/
*.swp
*~

# Env / secrets (never commit tokens)
.env
.env.*
*.pem

# Logs & temp
*.log
npm-debug.log*
.turbo/
coverage/
tmp/
*.tsbuildinfo

# Packaged/signed extension artifacts
*.crx
*.zip

# ---------------------------------------------------------------------------
# Build / compile outputs (edit TypeScript SoT; run `npm run build`)
# ---------------------------------------------------------------------------

# Modal bundle + vendor chunks (build-modal.mjs)
src/modal/dist/

# Source maps / accidental tsc emit
**/*.js.map
**/*.css.map
**/*.d.ts.map
# tsc declaration emit if someone turns on declaration (ambient SoT d.ts are explicit paths below)
# Do NOT use a blanket *.d.ts ignore — hand-written ambient contracts stay tracked:
#   extension-globals.d.ts, host-context.d.ts, modal/globals.d.ts, *-shims.d.ts, etc.

# pure modules emitted from src/modal/lib/*.ts via `npm run build:pure`
# Keep hand-written pure SoT (lib re-exports these):
src/modal/pure/**
!src/modal/pure/checks.js
!src/modal/pure/detail-merge.js

# content-script / popup entries compiled from src/*.ts (`build:content-ts`)
src/tree.js
src/dom.js
src/pr-list-focus.js
src/pulls-palette.js
src/github-endpoints.js
src/content-bootstrap.js
src/content.js
src/popup.js
src/storage.js

# other classic scripts compiled / assembled from TS SoT
src/content-bridge.js
src/fetch-pulls.js
src/pr-modal-host.js
src/background.bundle.js
# intermediate emit from sw-api.ts (build:background-src); SW loads the bundle
src/background.ts
# legacy hand twin if present after migration
src/background.js

# obsolete host part assemblies (SoT: src/host/modules/*.ts → pr-modal-host.js)
src/host/parts/**
# inventory dump from older part extractors (not runtime SoT)
src/host/modules/MANIFEST.json

# deprecated CSS stub (SoT: styles/index.css + sibling residual)
src/modal/styles.css
.bundle-entry.css
dogfood-output/
