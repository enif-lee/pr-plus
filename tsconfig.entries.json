{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": [
      "chrome"
    ],
    "moduleDetection": "legacy"
  },
  "include": [
    "src/extension-globals.d.ts",
    "src/entries-shim.d.ts",
    "src/tree.ts",
    "src/dom.ts",
    "src/content.ts",
    "src/content-bootstrap.ts",
    "src/content-bridge.ts",
    "src/popup.ts",
    "src/storage.ts",
    "src/github-endpoints.ts",
    "src/pr-list-focus.ts",
    "src/pulls-palette.ts"
  ]
}
