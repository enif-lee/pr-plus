{
  "name": "pr-plus",
  "version": "1.6.2",
  "private": true,
  "scripts": {
    "build:modal": "node scripts/build-modal.mjs",
    "build:sw": "node scripts/build-sw.mjs",
    "build": "npm run build:pure && npm run build:content-ts && npm run build:fetch && npm run build:background-src && npm run build:sw && npm run build:host && npm run build:content-bridge && npm run build:app-parts && npm run build:modal",
    "package": "npm run build && node scripts/package-extension.mjs",
    "test": "npm run build && rstest run",
    "browser:login": "agent-browser close --all 2>/dev/null; agent-browser open https://github.com/login",
    "browser:pulls": "agent-browser close --all 2>/dev/null; agent-browser open https://github.com/enif-lee/pr-plus/pulls",
    "browser:open": "agent-browser close --all 2>/dev/null; agent-browser open",
    "browser:close": "agent-browser close --all",
    "browser:snapshot": "agent-browser snapshot -i -c",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.host.json && tsc --noEmit -p tsconfig.fetch.json && tsc --noEmit -p tsconfig.bridge.json && node scripts/typecheck-entries.mjs",
    "test:unit": "rstest run",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "build:host": "node scripts/build-host.mjs",
    "build:fetch": "node scripts/build-fetch.mjs",
    "build:app-parts": "node scripts/build-pr-modal-app.mjs && node scripts/build-conversation-view.mjs",
    "build:content-bridge": "node scripts/build-content-bridge.mjs",
    "build:background-src": "node scripts/build-background-src.mjs",
    "build:pure": "node scripts/build-pure.mjs",
    "build:content-ts": "node scripts/build-content-ts.mjs",
    "typecheck:domain": "tsc --noEmit",
    "typecheck:all-projects": "tsc --noEmit && tsc --noEmit -p tsconfig.host.json && tsc --noEmit -p tsconfig.fetch.json && tsc --noEmit -p tsconfig.bridge.json && tsc --noEmit -p tsconfig.entries.json",
    "typecheck:entries": "node scripts/typecheck-entries.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rstest/core": "^0.11.4",
    "@types/chrome": "^0.2.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.21",
    "postcss-import": "^16.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-test-renderer": "^19.2.7",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "zustand": "^5.0.14"
  },
  "dependencies": {
    "@primer/octicons-react": "^19.29.2",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.7",
    "mermaid": "^11.16.0"
  }
}
