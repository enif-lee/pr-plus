{
  "name": "pr-plus",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "build:modal": "node scripts/build-modal.mjs",
    "build": "npm run build:modal",
    "test": "npm run build:modal && node tests/run-all.js",
    "browser:login": "agent-browser close --all 2>/dev/null; agent-browser open https://github.com/login",
    "browser:pulls": "agent-browser close --all 2>/dev/null; agent-browser open https://github.com/rtzr/callabo-server/pulls",
    "browser:open": "agent-browser close --all 2>/dev/null; agent-browser open",
    "browser:close": "agent-browser close --all",
    "browser:snapshot": "agent-browser snapshot -i -c"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.7"
  }
}
