{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["chrome"],
    "moduleDetection": "legacy"
  },
  "include": [
    "src/extension-globals.d.ts",
    "src/fetch/fetch-api.ts",
    "src/fetch/fetch-shims.d.ts"
  ]
}
