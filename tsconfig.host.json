{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": false,
    "strictNullChecks": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "vite/client",
      "chrome",
      "node"
    ],
    "paths": {
      "@modal/*": [
        "./src/modal/*"
      ],
      "@lib/*": [
        "./src/modal/lib/*"
      ],
      "@common/*": [
        "./src/modal/components/common/*"
      ]
    },
    "moduleDetection": "legacy"
  },
  "include": [
    "src/extension-globals.d.ts",
    "src/host/host-context.d.ts",
    "src/host/modules/**/*.ts",
    "src/host/modules/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
