{
  "manifest_version": 3,
  "name": "pr+",
  "version": "1.2.0",
  "description": "Display GitHub pull requests as a tree based on base/head branch relationships.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "pr+",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": [
        "src/tree.js",
        "src/dom.js",
        "src/content-bridge.js",
        "src/content-bootstrap.js",
        "src/content.js",
        "src/modal/dist/pr-modal.bundle.js",
        "src/pr-modal-host.js"
      ],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/modal/dist/pr-modal.css",
        "src/modal/dist/pr-modal.bundle.js"
      ],
      "matches": ["https://github.com/*"]
    }
  ]
}
