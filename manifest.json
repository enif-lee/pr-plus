{
  "manifest_version": 3,
  "name": "pr+",
  "version": "1.4.1",
  "description": "GitHub PR stack tree on /pulls plus a fast in-page review shell: Conversation, Diff, Mermaid, progressive load, merge, and deep links without leaving the list.",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background.bundle.js"
  },
  "action": {
    "default_title": "pr+",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": [
        "src/tree.js",
        "src/dom.js",
        "src/github-endpoints.js",
        "src/content-bridge.js",
        "src/content-bootstrap.js",
        "src/content.js",
        "src/modal/pure/detail-idb-cache.js",
        "src/modal/pure/detail-cache.js",
        "src/modal/dist/pr-modal.bundle.js",
        "src/pr-modal-host.js"
      ],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/modal/dist/pr-modal.css",
        "src/modal/dist/pr-modal.bundle.js",
        "src/modal/dist/mermaid.esm.js",
        "src/modal/dist/hljs-langs/*",
        "src/modal/dist/hljs-langs/*.js"
      ],
      "matches": ["https://*/*"],
      "use_dynamic_url": true
    }
  ]
}
