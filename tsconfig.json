{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@modal/*": [
        "./src/modal/*"
      ],
      "@lib/*": [
        "./src/modal/lib/*"
      ],
      "@common/*": [
        "./src/modal/components/common/*"
      ]
    },
    "types": [
      "vite/client",
      "chrome"
    ]
  },
  "include": [
    "src/modal/**/*.ts",
    "src/modal/**/*.tsx",
    "src/background.ts",
    "src/storage.ts",
    "src/github-endpoints.ts",
    "tests/**/*.rstest.ts",
    "rstest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "src/background/parts",
    "src/content-bridge/parts",
    "src/fetch/parts",
    "src/host/parts",
    "src/modal/app/PrModalApp.generated.tsx",
    "src/modal/app/pr-modal/parts",
    "src/modal/dist",
    "src/modal/pure",
    "src/modal/views/conversation/ConversationView.tsx",
    "src/modal/views/conversation/parts"
  ]
}
