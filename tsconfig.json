{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@modal/*": ["./src/modal/*"],
      "@lib/*": ["./src/modal/lib/*"],
      "@common/*": ["./src/modal/components/common/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/modal/**/*.ts", "src/modal/**/*.tsx", "vite.config.ts"],
  "exclude": ["node_modules", "src/modal/dist", "src/modal/pure"]
}
